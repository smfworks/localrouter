# SMF Works site settings for deploy/strix-halo on our Strix Halo workstation (Radeon 8060S, 96 GiB GTT).
# Use: SITE=deploy/smf/strix-halo.env deploy/strix-halo/start.sh
# Points the deployment at model directories that already exist on the box instead of $J/models, so nothing is
# downloaded twice. Paths are relative to $HOME; no hostnames or credentials belong here.
FLASHNEXT_DIR=$HOME/llm/models/Qwen3.8-Flash-Next-GGUF     # UD-Q4_K_XL/ (Gufo), UD-Q3_K_XL/ (llama.cpp), MTP/, mmproj-BF16.gguf
Q3_DIR=$FLASHNEXT_DIR
TTS_DIR=$HOME/gufo/models/Qwen3-TTS-12Hz-1.7B-CustomVoice
ASR_DIR=$HOME/gufo/models/Qwen3-ASR-1.7B
WHISPER_DIR=$HOME/lr-eval/models/whisper-large-v3-turbo/41f01f3fe87f28c78e2fbf8b568835947dd65ed9
LLAMA_BIN=$HOME/llm/bin-us-vk                              # Unsloth llama.cpp b12347 Vulkan (loads the shared MTP head)
MACHINE=smf-strix-halo
VOICE=serena
COMFY_HF=$HOME/comfy/hf                                    # MiniMax weights already downloaded; comfyui/install.sh links them
